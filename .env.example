# URL de l'API Laravel.
# Volontairement SANS préfixe NEXT_PUBLIC_ : cette valeur ne doit jamais être
# exposée au navigateur. Tous les appels API partent du serveur Next.js via le
# Data Access Layer (§2.1 et §4 du plan d'action).
API_BASE_URL=http://localhost:8000/api/v1

# Clé de chiffrement du cookie de session qui transporte le token Sanctum.
# 32 caractères minimum. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
